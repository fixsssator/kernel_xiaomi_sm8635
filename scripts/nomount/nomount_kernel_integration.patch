# Bouteillepleine NoMount-Suite hookless Prism Engine integration.
# Apply before SUSFS: SUSFS and NoMount both touch fs/proc/task_mmu.c, so the
# maps metadata hook is added by integrate-bakasu.sh after SUSFS is complete.
#
# The engine lives in fs/nomount/ (rather than a flat fs/nomount.c) so its
# Kconfig and Kbuild wiring remain self-contained.

diff --git a/fs/Kconfig b/fs/Kconfig
--- a/fs/Kconfig
+++ b/fs/Kconfig
@@ -5,6 +5,8 @@
 menu "File systems"
 
+source "fs/nomount/Kconfig"
+
 # Use unaligned word dcache accesses
 config DCACHE_WORD_ACCESS
        bool

diff --git a/fs/Makefile b/fs/Makefile
--- a/fs/Makefile
+++ b/fs/Makefile
@@ -56,6 +56,8 @@
 obj-y				+= quota/
 
+obj-$(CONFIG_NOMOUNT) += nomount/
+
 obj-$(CONFIG_PROC_FS)		+= proc/
 obj-$(CONFIG_KERNFS)		+= kernfs/
 obj-$(CONFIG_SYSFS)		+= sysfs/
 obj-$(CONFIG_CONFIGFS_FS)	+= configfs/

